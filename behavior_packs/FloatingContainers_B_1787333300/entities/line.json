{
  "format_version": "1.13.0",
  "minecraft:entity": {
    "description": {
      "identifier": "effectoo:line",
      "is_summonable": true,
      "is_spawnable": false,
      "properties": {
        "line:size": { "type": "float", "range": [ -1024.0, 1024.0 ], "default": 0.0, "client_sync": true },
        "line:rotation_x": { "type": "float", "range": [ -360.0, 360.0 ], "default": 0.0, "client_sync": true },
        "line:rotation_y": { "type": "float", "range": [ -360.0, 360.0 ], "default": 0.0, "client_sync": true }
      }
    },
    "component_groups": {
      "despawn": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [ "inanimate" ]
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "all",
          "deals_damage": false
        }
      },
      "minecraft:knockback_resistance": {
        "value": 100,
        "max": 100
      },
      "minecraft:collision_box": {
        "width": 0,
        "height": 0
      },
      "minecraft:conditional_bandwidth_optimization": {
      },
      "minecraft:persistent": {
      },
      "minecraft:tick_world": {
      },
      "minecraft:physics": {
        "has_gravity": false,
        "has_collision": false
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:environment_sensor": {
        "triggers": [
          { "filters": {
            "any_of": [ 
                { "test": "in_block", "operator": "==", "value": "air" },
                { "test": "in_block", "operator": "==", "value": "water" }
              ]
            },
            "event": "despawn" 
          }
        ]
      }
    },
    "events": {
      "despawn": {
        "add": { "component_groups": "despawn" }
      }
    }
  }
}